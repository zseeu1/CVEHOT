{
  "$comment": "漏洞行业信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里增删改。字段说明见 docs/customize.md，本包的说明见 docs/cve-pack.md。json_list 抓 api.github.com 时会自动带上 .env 里的 GITHUB_TOKEN。",
  "sources": [
    {
      "id": "rss-ghsa-db",
      "name": "GitHub Advisory Database",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/github/advisory-database/commits/main.atom",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 30,
      "tags": [
        "官方",
        "GitHub"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-cvelistv5",
      "name": "CVE Program (cvelistV5)",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/CVEProject/cvelistV5/commits/main.atom",
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 30,
      "tags": [
        "官方",
        "CVE"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-ossf-malicious-packages",
      "name": "OpenSSF Malicious Packages",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/ossf/malicious-packages/commits/main.atom",
        "_aihot": {
          "initialBackfillLimit": 6
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "官方",
        "供应链"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-poc-in-github",
      "name": "PoC in GitHub",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/nomi-sec/PoC-in-GitHub/releases.atom",
        "_aihot": {
          "initialBackfillLimit": 5
        }
      },
      "tier": "T2",
      "first_party": false,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "PoC"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-trickest-cve",
      "name": "trickest/cve",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/trickest/cve/commits/main.atom",
        "_aihot": {
          "initialBackfillLimit": 5
        }
      },
      "tier": "T2",
      "first_party": false,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "PoC"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "json-ghsa-api",
      "name": "GitHub 安全公告 API",
      "kind": "json_list",
      "config": {
        "url": "https://api.github.com/advisories?per_page=100",
        "titlePaths": [
          "summary"
        ],
        "summaryPaths": [
          "description"
        ],
        "publishedAtPath": "published_at",
        "externalIdPath": "ghsa_id",
        "urlTemplate": "{raw:html_url}"
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 30,
      "tags": [
        "官方",
        "GitHub"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "json-cisa-kev",
      "name": "CISA KEV（在野利用清单）",
      "kind": "json_list",
      "config": {
        "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
        "itemsPath": "vulnerabilities",
        "titlePaths": [
          "vulnerabilityName"
        ],
        "summaryPaths": [
          "shortDescription",
          "requiredAction"
        ],
        "publishedAtPath": "dateAdded",
        "externalIdPath": "cveID",
        "urlTemplate": "https://nvd.nist.gov/vuln/detail/{cveID}"
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 120,
      "tags": [
        "官方",
        "在野利用"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "json-gh-new-cve-repos",
      "name": "GitHub 新出现的 CVE 仓库",
      "kind": "json_list",
      "config": {
        "url": "https://api.github.com/search/repositories?q=CVE-+in:name,description&sort=updated&order=desc&per_page=60",
        "itemsPath": "items",
        "titlePaths": [
          "full_name"
        ],
        "summaryPaths": [
          "description"
        ],
        "publishedAtPath": "created_at",
        "externalIdPath": "id",
        "urlTemplate": "{raw:html_url}",
        "requireBoolean": {
          "path": "fork",
          "equals": false
        },
        "minNumeric": {
          "path": "stargazers_count",
          "min": 1
        }
      },
      "tier": "T2",
      "first_party": false,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "PoC",
        "GitHub"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    }
  ]
}
